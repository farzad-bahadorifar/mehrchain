# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or local Docker)
DATABASE_URL="postgresql://user:password@localhost:5432/mehrchain?schema=public"

# JWT Secret for authenticating mobile and web sessions
JWT_SECRET="mehrchain_super_secret_jwt_key_2026"

# Backend server port
PORT=3000

# Public Google OAuth WEB client ID. Configure the same value in Render and Cloudflare builds.
GOOGLE_CLIENT_ID=""
# Set only in server environments; never embed an API key in the frontend.
RESEND_API_KEY=""
MAIL_FROM="MehrChain <verify@your-verified-domain.example>"
