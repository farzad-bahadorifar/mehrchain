{
  "name": "mehrchain-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mehrchain-frontend/src",
  "prefix": "app",
  "generators": {},
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "browser": "apps/mehrchain-frontend/src/main.ts",
        "tsConfig": "apps/mehrchain-frontend/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mehrchain-frontend/public",
            "output": "/"
          },
          {
            "glob": "favicon.ico",
            "input": "apps/mehrchain-frontend/public",
            "output": "/"
          }
        ],
        "styles": ["apps/mehrchain-frontend/src/styles.css"],
        "outputPath": "dist/mehrchain-frontend"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/mehrchain-frontend/src/environments/environment.ts",
              "with": "apps/mehrchain-frontend/src/environments/environment.prod.ts"
            }
          ],
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": false
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1MB",
              "maximumError": "2MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kB",
              "maximumError": "8kB"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "ngsw-config.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"]
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "mehrchain-frontend:build:production"
        },
        "development": {
          "buildTarget": "mehrchain-frontend:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "test": {
      "executor": "@angular/build:unit-test"
    }
  }
}
