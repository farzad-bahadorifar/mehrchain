// File: apps/mehrchain-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pillar categories for commitments
enum Category {
  health
  growth
  community
  environment
}

enum ChainStatus {
  ACTIVE
  RESTING
  FADING
  COMPLETED
  DORMANT
  DISCONNECTED
}

enum ChainInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// User model for persistent authentication and identity
model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  username                  String    @unique
  name                      String?
  passwordHash              String
  role                      String    @default("USER")
  isEmailVerified           Boolean   @default(false)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  metadata                  Json? // Extensible metadata for future gamification & preferences

  commitments Commitment[]

  // Relations for Chain
  userChains    ChainConnection[] @relation("UserChains")
  partnerChains ChainConnection[] @relation("PartnerChains")
  chainInvites  ChainInvite[]     @relation("SenderInvites")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@map("users")
}

// Core habit commitment model
model Commitment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title                 String
  category              Category
  why                   String?
  totalDays             Int
  currentDay            Int       @default(0)
  currentStreak         Int       @default(0)
  consecutiveMissedDays Int       @default(0) // Used for Chain freeze logic
  startDate             DateTime  @default(now())
  lastCompletedDate     DateTime?
  reminderTime          String?
  isPublic              Boolean   @default(false)
  isArchived            Boolean   @default(false)

  rippleEffects String[] // Potential connected chain effects
  history       String[] // Legacy date strings
  logs          CommitmentLog[] // Granular completion logs

  // Relations for Chain
  userChains    ChainConnection[] @relation("UserChainCommitment")
  partnerChains ChainConnection[] @relation("PartnerChainCommitment")
  chainInvites  ChainInvite[]     @relation("SenderCommitmentInvites")

  metadata Json? // Extensible metadata for future modules

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("commitments")
}

// Granular completion log for activity tracking & future analytics
model CommitmentLog {
  id           String     @id @default(uuid())
  commitmentId String
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())
  note        String?
  metadata    Json? // Future metrics (e.g. mood, energy level)

  @@index([commitmentId])
  @@map("commitment_logs")
}

// Two-way active chain connection between users
model ChainConnection {
  id String @id @default(uuid())

  userId    String
  partnerId String

  userCommitmentId    String
  partnerCommitmentId String

  status                ChainStatus @default(ACTIVE)
  consecutiveMissedDays Int         @default(0)
  lastPartnerActivityAt DateTime?
  lastNudgeSentAt       DateTime?
  heartSent             Boolean     @default(false)

  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  user              User       @relation("UserChains", fields: [userId], references: [id], onDelete: Cascade)
  partner           User       @relation("PartnerChains", fields: [partnerId], references: [id], onDelete: Cascade)
  userCommitment    Commitment @relation("UserChainCommitment", fields: [userCommitmentId], references: [id], onDelete: Cascade)
  partnerCommitment Commitment @relation("PartnerChainCommitment", fields: [partnerCommitmentId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId, userCommitmentId])
  @@map("chain_connections")
}

// Invite flow replacing old direct requests
model ChainInvite {
  id String @id @default(uuid())

  senderId           String
  senderCommitmentId String

  inviteCode String            @unique @default(uuid())
  status     ChainInviteStatus @default(PENDING)

  acceptedById         String?
  acceptedCommitmentId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  sender           User       @relation("SenderInvites", fields: [senderId], references: [id], onDelete: Cascade)
  senderCommitment Commitment @relation("SenderCommitmentInvites", fields: [senderCommitmentId], references: [id], onDelete: Cascade)

  @@map("chain_invites")
}
